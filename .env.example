# Smakaduta.ai — Environment Variables
# Copy this file to .env.local and fill in the values

# ═══════════════════════════════════════════
# AI Provider (9router / OpenRouter Compatible)
# ═══════════════════════════════════════════
AI_BASE_URL=https://9router.menoo.my.id/v1
AI_API_KEY=your-api-key-here
AI_MODEL=oc/big-pickle
AI_FALLBACK_MODELS=oc/mimo-v2.5-free,oc/ling-3.0-flash-fin-free,oc/muse-spark-1.3-contributor-free
OPENROUTER_API_KEY=your-api-key-here

# ═══════════════════════════════════════════
# Embeddings (Nvidia NIM 2048 dims for Neon pgvector)
# ═══════════════════════════════════════════
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=your-nvidia-api-key-here
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# ═══════════════════════════════════════════
# Neon Database (Serverless Postgres + pgvector)
# Get your connection string at: https://neon.tech
# Format: postgresql://user:pass@host/dbname?sslmode=require
# ═══════════════════════════════════════════
DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# ═══════════════════════════════════════════
# Vercel AI Gateway (Optional - for caching)
# Get your key at: https://vercel.com/ai/api-keys
# ═══════════════════════════════════════════
AI_GATEWAY_API_KEY=

# ═══════════════════════════════════════════
# Admin Authentication
# Set a strong password for admin dashboard access
# ═══════════════════════════════════════════
ADMIN_SECRET=your-super-secret-admin-password-here
